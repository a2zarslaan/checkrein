{
  "checkrein": { "manifest_version": 2 },
  "project": {
    "name": "notes-app",
    "description": "A small notes app used as a passing fixture.",
    "tracker": "github"
  },
  "vcs": {
    "trunk": "main",
    "release_branch": ""
  },
  "commands": {
    "lint": "",
    "typecheck": "",
    "test": "node --test",
    "build": "",
    "format_check": ""
  },
  "paths": {
    "docs_dir": "project-documentation/",
    "brief": "project-documentation/project-brief.md",
    "architecture": "project-documentation/architecture.md",
    "business_rules": "project-documentation/business-rules.md",
    "corrections_log": "project-documentation/corrections-log.md",
    "state_doc": "project-documentation/current-project-state.md",
    "changelog": "project-documentation/CHANGELOG.md",
    "working_docs_dir": "project-documentation/temp/",
    "runbooks_dir": "project-documentation/runbooks/",
    "refdocs_root": "reference-documentation/"
  },
  "workspaces": [
    { "name": "app", "root": "." }
  ],
  "protected_trees": [],
  "secret_globs": [".env", ".env.*"],
  "domains": ["backend", "frontend", "database", "auth", "shared", "infra", "process"],
  "areas": ["notes", "search"],
  "review": {
    "confidence_floor": 75
  },
  "production_markers": {
    "hosts": ["notes.example.internal", "10.20.30.40"],
    "logins": ["deploy-user@", "ops@notes.example.internal"],
    "ports": [55000],
    "database_url_patterns": ["[a-z]+://[^\\s]*@db\\.example\\.internal"]
  },
  "example_globs": [".env.example", "*.example", "*.sample"],
  "approval": {
    "ask": ["push", "pr_create", "pr_merge", "dependency_change"],
    "dependency_commands": ["uv add", "bundle add"]
  },
  "consulted": {
    "mode": "block",
    "code_globs": ["src/**", "**/src/**"],
    "required_reads": ["project-documentation/architecture.md"]
  }
}
